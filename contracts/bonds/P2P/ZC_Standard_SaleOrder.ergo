{
    // Standard sale order (an ask). No specs and no off-chain code exist yet.
    // Sells one token for a fixed price per raw unit, with partial fills. It is generic: the token
    // can be a bond unit, fractional shares, or anything else. Nothing here verifies what the token
    // is: a buyer, or a buying contract such as ZC_Standard_LendOffer, does that.
    //
    // CONSTANTS
    // CONST_PAYMENT_TOKEN: Coll[Byte] - the asset the seller is paid in; EMPTY for ERG. Each payment
    //   asset therefore has its own address under one shared template. The token for sale is held
    //   in the box, so an indexed node finds asks for it by token id.
    //
    // TOKENS
    // tokens(0): (token for sale, amount remaining) - the only token allowed
    //
    // REGISTERS
    // R4: Coll[Byte] - blake2b256 of the seller script: is paid, may cancel
    // R5: Coll[Long] - (price numerator, price denominator, minimum fill, expiry height)
    //   The price of u raw units is ceil(u * numerator / denominator) raw units of the payment
    //   asset, so shares can be priced below one payment unit each. A fill below the minimum is
    //   allowed only when it takes everything that is left. Fills require HEIGHT < expiry; from
    //   expiry on, anyone may refund.
    //
    // VALUE
    // At least the box minimum. nanoERG funded above 1000000 is the fee for an expiry refund; it
    // survives partial fills, because a continuation keeps at least this value.
    //
    // FILL (anyone, before expiry)
    // Context var 0: Int payout index. Context var 1: Int continuation index, absent for a full take.
    // Payout (the ask convention, shared with ZC_Standard_NavAsk): at the seller script, R4 = SELF.id,
    //   R5: Long = the raw units this payout pays for, holding at least the price. For a token
    //   price the payment token is the payout's tokens(0), and the buyer funds the box's nanoERG.
    // Continuation: this script, R4 and R5 unchanged, value not lower, tokens(0) = what is left.
    //
    // EXPIRY REFUND (anyone, once HEIGHT >= expiry)
    // Context var 0: Int refund index. The refund is at the seller script with R4 = SELF.id and
    // every token of this box, and keeps at least 1000000 nanoERG (all of the value, if this box
    // holds less). The rest pays the batcher. The tag lets a seller that is a contract, which
    // cannot co-sign a cancel, recognise its tokens. With no fee funded, the tokens wait for the
    // seller to cancel.
    //
    // CANCEL
    // A co-spent box guarded by the seller script releases this box at any height.
    //
    // ASSUMPTIONS
    // - The price is the seller's limit and is public. A buying contract does not read it: it
    //   counts what the payout holds as its price. The payout states the units it pays for, so a
    //   buyer that checks R5 against the units it receives cannot be charged for units that went
    //   elsewhere, and anything above this ask's price reaches the seller, not the batcher.
    // - The batcher fee is the buyer's to set. This order pays none.

    val sellerHash = SELF.R4[Coll[Byte]].get
    val sellerAuth = INPUTS.exists { (b: Box) =>
        b.id != SELF.id && blake2b256(b.propositionBytes) == sellerHash
    }

    if (sellerAuth) {
        sigmaProp(true)
    } else {
        val terms = SELF.R5[Coll[Long]].get
        val payoutIndex = getVar[Int](0).get
        val nextIndex = getVar[Int](1)
        if (terms.size != 4 || SELF.tokens.size != 1 || payoutIndex < 0 || payoutIndex >= OUTPUTS.size) {
            sigmaProp(false)
        } else if (HEIGHT.toLong >= terms(3)) {
            // Expiry refund, by anyone: the tokens go back to the seller. The batcher's fee is
            // whatever nanoERG the seller funded above 1000000.
            val refund = OUTPUTS(payoutIndex)
            sigmaProp(
                blake2b256(refund.propositionBytes) == sellerHash &&
                refund.R4[Coll[Byte]].get == SELF.id &&
                refund.tokens == SELF.tokens &&
                (refund.value >= 1000000L || refund.value >= SELF.value)
            )
        } else {
            val numerator = terms(0)
            val denominator = terms(1)
            val minFill = terms(2)
            val have = SELF.tokens(0)._2
            val payout = OUTPUTS(payoutIndex)

            val continued = if (nextIndex.isDefined) {
                val index = nextIndex.get
                if (index < 0 || index >= OUTPUTS.size || index == payoutIndex) {
                    false
                } else {
                    val next = OUTPUTS(index)
                    next.propositionBytes == SELF.propositionBytes &&
                    next.value >= SELF.value &&
                    next.tokens.size == 1 &&
                    next.tokens(0)._1 == SELF.tokens(0)._1 &&
                    next.tokens(0)._2 >= 1L && next.tokens(0)._2 < have &&
                    next.R4[Coll[Byte]].get == sellerHash &&
                    next.R5[Coll[Long]].get == terms
                }
            } else true

            if (!continued || numerator <= 0L || denominator <= 0L) {
                sigmaProp(false)
            } else {
                val remaining = if (nextIndex.isDefined) OUTPUTS(nextIndex.get).tokens(0)._2 else 0L
                val sold = have - remaining
                val price = (sold.toBigInt * numerator.toBigInt + denominator.toBigInt - 1L.toBigInt) /
                    denominator.toBigInt
                // An empty collection taken from the box, not a literal: testing the constant alone
                // is folded at compile time and would give each payment asset a different template.
                val noToken = SELF.id.slice(0, 0)
                val paid = if (CONST_PAYMENT_TOKEN == noToken) {
                    payout.value
                } else if (payout.tokens.size > 0 && payout.tokens(0)._1 == CONST_PAYMENT_TOKEN) {
                    payout.tokens(0)._2
                } else 0L

                sigmaProp(
                    sold >= 1L && (sold >= minFill || remaining == 0L) &&
                    blake2b256(payout.propositionBytes) == sellerHash &&
                    payout.R4[Coll[Byte]].get == SELF.id &&
                    payout.R5[Long].get == sold &&
                    paid.toBigInt >= price
                )
            }
        }
    }
}
