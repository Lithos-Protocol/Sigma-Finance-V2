{
    // EXPERIMENTAL SigmaFi V2 bond. No corresponding off-chain code exists.
    // Use only with EXP_ZC_Order/EXP_ZC_OrderOnClose and EXP_BondAssetVault.
    // CONST_VAULT_HASH MUST name EXP_BondAssetVault, never the production vault.
    // R9: Coll[Long] = (N, repayment ERG floor excluding fee refund). N is pinned by the order.
    // Whole: N=1, reserve=1, circulating=1 raw unit. Fractional: circulating C=N*1000000000,
    // reserve=C+1, verified mint cap=2*C+1, 1 <= N <= 1000000000. Burn the entire reserve.
    // BOTH settlement paths require >= N nanoERG and >= N raw units of every payout token,
    // including custom liquidation assets, so one whole displayed share can claim >= 1 raw unit.
    // A custom liquidation rule must support these amounts or its transaction is rejected.
    // Settlement adds R7: Long = initial claim supply and R8: Coll[Byte] = SELF.id.
    // No other input may carry this asset, so settlement cannot destroy circulating shares.
    // Majority authentication needs a verified mint cap, asset id and script; see experimental order.
    // Storage-rent extraction is outside normal script evaluation; no rent-proof origin scheme exists.
    // Lost shares or voluntary burns outside redemption can strand vault assets.
    // Existing MaturityLiquidation is reusable: tokens(1..) remain collateral in both modes.
    //
    // Zero-coupon token bond: repay before maturity, or run the agreed liquidation expression.
    //
    // REGISTERS
    // R4: Coll[Byte] - originating order id, also the bond asset id
    // R5: Coll[Byte] - blake2b256 of the borrower's ErgoTree
    // R6: Coll[Long] - (repayment in CONST_TOKEN_ID, lender fee reserve, principal nanoERG, maturity height)
    // R7: Coll[(Coll[Byte], Long)] - agreed principal tokens; empty for an ERG loan
    // R8: Coll[Byte] - blake2b256 of the serialized liquidation expression
    // R9: Coll[Long] - (whole displayed circulating supply N, repayment ERG floor excluding fee)
    //
    // CONSTANTS
    // CONST_VAULT_HASH: Coll[Byte] - blake2b256 of EXP_BondAssetVault; every settlement pays it
    // CONST_TOKEN_ID: Coll[Byte] - the repayment token id
    //
    // TOKENS
    // tokens(0): (bond asset, 1 or N*1000000000+1), burned on both paths
    // tokens(1..): collateral tokens
    //
    // CONTEXT VARS
    // 0: Coll[Byte] - liquidation expression; its absence selects repayment
    // 1: Int - settlement output index (both paths)
    // 2: Int - collateral return output index (repayment only)
    //
    // OUTPUTS
    // Context vars select outputs independently of input positions; no filler inputs needed.
    // Settlement: R4 = SELF.id, R5 = bond asset id, R6: Byte = 0 repaid / 1 liquidated. Collateral return: R4 = SELF.id.
    // Repayment requires distinct settlement and return indices.
    //
    // ASSUMPTIONS
    // - A verified experimental order pinned the selected exact supply, reserve, and bond terms.
    //   This script alone does not authenticate a hand-made bond's origin or its asset's mint supply.
    // - The liquidation expression controls eligibility AND the vault's ERG and tokens. Both parties
    //   must inspect it. The bond always enforces the vault, settlement tags, and reserve burn.
    // - Anyone may repay in full; liquidation may run before maturity if the agreed expression allows it.

    // Helper Methods
    def numTokenInOutputs(tokenId: Coll[Byte]): Long = {
        OUTPUTS.fold(0L, {
            (a: Long, b: Box) =>
                val totalTokens = b.tokens.fold(0L, {
                    (z: Long, t: (Coll[Byte], Long)) => if(t._1 == tokenId) z + t._2 else z
                })
                a + totalTokens
        })
    }

    def numTokenInInputs(tokenId: Coll[Byte]): Long = {
        INPUTS.fold(0L, { (a: Long, b: Box) =>
            val count = b.tokens.fold(0L, { (z: Long, t: (Coll[Byte], Long)) =>
                if (t._1 == tokenId) z + t._2 else z
            })
            a + count
        })
    }

    val lockedAmount     = SELF.tokens(0)._2
    val shareTerms       = SELF.R9[Coll[Long]].get
    val wholeTokens      = shareTerms(0)
    val repaymentERGFloor = shareTerms(1)
    val circulating      = if (lockedAmount == 1L) 1L else wholeTokens * 1000000000L
    val validReserve     = if (lockedAmount == 1L) wholeTokens == 1L else
        wholeTokens >= 1L && wholeTokens <= 1000000000L && lockedAmount == circulating + 1L
    val borrowerHash     = SELF.R5[Coll[Byte]].get
    val amounts          = SELF.R6[Coll[Long]].get
    val repayment        = amounts(0)
    val batchingFee      = amounts(1)
    val maturityHeight   = amounts(3)
    val liqScriptHash    = SELF.R8[Coll[Byte]].get
    val bondAssetId      = SELF.tokens(0)._1
    val collateralAssets = SELF.tokens.slice(1, SELF.tokens.size)
    val collateralERG    = SELF.value - batchingFee

    // Shared by both paths, so evaluating these eagerly costs neither path anything it does not need
    val settlementIndex = getVar[Int](1).get
    if (!validReserve || shareTerms.size != 2 || repaymentERGFloor <= 0L || SELF.R4[Coll[Byte]].get != bondAssetId ||
        amounts.size != 4 || batchingFee < 0L || batchingFee > SELF.value - 1000000L ||
        settlementIndex < 0 || settlementIndex >= OUTPUTS.size) {
        sigmaProp(false)
    } else {
        val settlementBox    = OUTPUTS(settlementIndex)
        val toVault          = blake2b256(settlementBox.propositionBytes) == CONST_VAULT_HASH
        // R5 is what the generic vault opens with. Unpinned, a settler could name an asset of its own
        // there and claim the lender's box from the vault itself.
        val settlementTagged =
            settlementBox.R4[Coll[Byte]].get == SELF.id &&
            settlementBox.R5[Coll[Byte]].get == bondAssetId &&
            settlementBox.R7[Long].get == circulating &&
            settlementBox.R8[Coll[Byte]].get == SELF.id
        val enoughTokenUnits = settlementBox.tokens.forall { (t: (Coll[Byte], Long)) =>
            t._2 >= wholeTokens
        }
        val redeemable = settlementBox.value >= wholeTokens && enoughTokenUnits
        // Burn only this bond's reserve, never circulating shares. Otherwise the initial vault
        // denominator could include shares destroyed in the settlement transaction itself.
        val assetBurned = numTokenInInputs(bondAssetId) == lockedAmount &&
            numTokenInOutputs(bondAssetId) == 0L

        val liquidationScript = getVar[Coll[Byte]](0)

        if (liquidationScript.isDefined) {
            val liquidated = allOf(
                Coll(
                    blake2b256(liquidationScript.get) == liqScriptHash,
                    toVault,
                    settlementTagged,
                    redeemable,
                    settlementBox.R6[Byte].get == 1.toByte,
                    assetBurned
                )
            )
            sigmaProp(liquidated) && executeFromVar[SigmaProp](0)
        } else {
            // Only repayment requires a collateral return index.
            val returnIndex = getVar[Int](2).get
            if (returnIndex < 0 || returnIndex >= OUTPUTS.size || returnIndex == settlementIndex) {
                sigmaProp(false)
            } else {
                val returnBox = OUTPUTS(returnIndex)
                // Lazy, so a settlement box without tokens is a rejection rather than an index error
                val repaymentPaid =
                    settlementBox.tokens.size == 1 &&
                    settlementBox.tokens(0)._1 == CONST_TOKEN_ID &&
                    settlementBox.tokens(0)._2 >= repayment
                val repaid = allOf(
                    Coll(
                        HEIGHT.toLong < maturityHeight,
                        // Repayment includes refund of the lender-funded reserve; subtract to avoid overflow.
                        toVault,
                        settlementTagged,
                        redeemable,
                        settlementBox.R6[Byte].get == 0.toByte,
                        settlementBox.value >= batchingFee &&
                        settlementBox.value - batchingFee >= repaymentERGFloor &&
                        settlementBox.value - batchingFee >= 1000000L,
                        repaymentPaid,
                        // ReturnBox Conditions
                        blake2b256(returnBox.propositionBytes) == borrowerHash,
                        returnBox.R4[Coll[Byte]].get == SELF.id,
                        returnBox.tokens == collateralAssets,
                        returnBox.value  >= collateralERG,
                        assetBurned
                    )
                )
                sigmaProp(repaid)
            }
        }
    }
}
