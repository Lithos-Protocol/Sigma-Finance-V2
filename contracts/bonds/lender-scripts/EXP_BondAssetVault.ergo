{
    // EXPERIMENTAL proportional SigmaFi V2 vault. No corresponding off-chain code exists.
    // Receives settlement from EXP_ZC_ERG_Bond / EXP_ZC_Token_Bond. Production bonds and
    // production BondAssetVault do not implement this state machine. No constants are injected.
    //
    // REGISTERS
    // R4: Coll[Byte] - original settled bond box id, preserved through every redemption
    // R5: Coll[Byte] - bond asset / circulating share id
    // R6: Byte - original settlement path: 0 repaid, 1 liquidated; preserved
    // R7: Long - outstanding raw claim units: initially 1 (whole) or N*1000000000
    //           (fractional), 1 <= N <= 1000000000; decreases by actual burned shares
    // R8: Coll[Byte] - predecessor box id: initially the settled bond id; then previous vault id
    // R9: unused, no economic meaning
    //
    // CONTEXT VARS ON THIS VAULT INPUT
    // 0: Int - payout output index (both paths). Payout R4: Coll[Byte] must equal SELF.id.
    // 1: Int - continuation output index (partial claim only), distinct from payout index
    //
    // REDEMPTION
    // Shares burned = transaction-wide input shares minus output shares. It must be in [1, R7].
    // Partial: pay floor(current balance * burned / outstanding) of ERG AND EACH collateral/
    // repayment token; preserve the rest under this exact script, with R7 reduced and R8 = SELF.id.
    // Products use BigInt before division: raw share amounts deliberately exceed safe Long products.
    // Final: pay all remaining ERG and tokens; no continuation required. Whole mode is a final claim.
    // Rounding dust remains in the vault, so the last claimant receives it. Splitting tiny claims may
    // receive zero token units. The denominator is the remaining supply, not the original mint supply.
    // Dynamic minting and BOTH bond settlement paths guarantee A*1000000000 >= R7 for
    // ERG and every payout token. This vault checks the invariant too, including for handmade boxes.
    // For a burn of one whole displayed token (1000000000 raw shares), floor(A*1e9/R7) >= 1.
    // After burning b raw shares, retained A' = ceil(A*(R7-b)/R7), so A'*1e9 >= R7-b.
    // Thus even arbitrary smaller burns preserve the guarantee for later whole-token claims.
    // Sub-token claims can round to zero. A final holder takes all dust. If R7 < 1e9, no whole
    // displayed token remains; final redemption of the smaller outstanding supply still works.
    // A single-unit NFT therefore permits at most one whole displayed circulating token, whose
    // smaller fractional holders must aggregate their claims to redeem that indivisible NFT.
    //
    // ASSUMPTIONS AND COMPOSITION
    // - Only one input with this exact vault script is allowed per transaction, across all asset ids.
    //   This prevents the same burn/payout from satisfying multiple vaults. Claims serialize per vault.
    // - The payout destination is chosen by share holders through their input authorization. This
    //   script does not split a joint claim among its input owners: they must agree before signing.
    // - Claimants fund fees and minimum-box ERG top-ups externally. Payout/continuation may receive
    //   extra ERG, but tokens are exact. A tiny payout still needs a consensus-valid output value.
    //   Partial claims leaving a sub-minimum continuation need an external ERG top-up; final closes it.
    // - Never deposit this vault's own shares into it. Such boxes are rejected, avoiding a public claim
    //   funded by the vault's own bearer asset. Official bond settlement already burns the reserve.
    // - Anyone can make fake vaults with arbitrary registers. Authenticate original bond settlement
    //   and subsequent transitions before treating a vault as the official payout. Tags alone do not
    //   prove ancestry. Other deposits do not automatically join this vault or its accounting.
    // - Lost shares or burns outside this redemption permanently strand their residual entitlement.
    //   No timeout, sweep authority, rent exemption, or redistribution of lost claims is implemented.
    // - The fractional bond reserve exceeds the entire claim denominator and cannot redeem a vault.
    //   The matching bond burns only its own reserve, before the official vault can be spent.
    // - Offline interpreter tests do not establish live-node serialization, max-cost or rent safety.

    def numTokenInInputs(tokenId: Coll[Byte]): Long = {
        INPUTS.fold(0L, { (a: Long, b: Box) =>
            val count = b.tokens.fold(0L, { (z: Long, t: (Coll[Byte], Long)) =>
                if (t._1 == tokenId) z + t._2 else z
            })
            a + count
        })
    }

    def numTokenInOutputs(tokenId: Coll[Byte]): Long = {
        OUTPUTS.fold(0L, { (a: Long, b: Box) =>
            val count = b.tokens.fold(0L, { (z: Long, t: (Coll[Byte], Long)) =>
                if (t._1 == tokenId) z + t._2 else z
            })
            a + count
        })
    }

    val assetId = SELF.R5[Coll[Byte]].get
    val remaining = SELF.R7[Long].get
    val inputShares = numTokenInInputs(assetId)
    val outputShares = numTokenInOutputs(assetId)
    val burned = inputShares - outputShares
    val payoutIndex = getVar[Int](0).get
    val vaultInputs = INPUTS.filter { (b: Box) => b.propositionBytes == SELF.propositionBytes }
    val holdsOwnShares = SELF.tokens.exists { (t: (Coll[Byte], Long)) => t._1 == assetId }
    val enoughERGUnits = SELF.value.toBigInt * 1000000000L.toBigInt >= remaining.toBigInt
    val enoughTokenUnits = SELF.tokens.forall { (t: (Coll[Byte], Long)) =>
        t._2.toBigInt * 1000000000L.toBigInt >= remaining.toBigInt
    }

    if (remaining <= 0L || remaining > 1000000000000000000L || burned <= 0L || burned > remaining ||
        vaultInputs.size != 1 || holdsOwnShares || !enoughERGUnits || !enoughTokenUnits ||
        payoutIndex < 0 || payoutIndex >= OUTPUTS.size) {
        sigmaProp(false)
    } else {
        val payout = OUTPUTS(payoutIndex)
        val payoutTagged = payout.R4[Coll[Byte]].get == SELF.id

        if (burned == remaining) {
            // All remaining dust is paid. The holder separately funds fees.
            sigmaProp(payoutTagged && payout.value >= SELF.value && payout.tokens == SELF.tokens)
        } else {
            val continuationIndex = getVar[Int](1).get
            if (continuationIndex < 0 || continuationIndex >= OUTPUTS.size || continuationIndex == payoutIndex) {
                sigmaProp(false)
            } else {
                val next = OUTPUTS(continuationIndex)
                val paidERG = (SELF.value.toBigInt * burned.toBigInt / remaining.toBigInt).toLong
                val paidTokens = SELF.tokens.map { (t: (Coll[Byte], Long)) =>
                    (t._1, (t._2.toBigInt * burned.toBigInt / remaining.toBigInt).toLong)
                }.filter { (t: (Coll[Byte], Long)) => t._2 > 0L }
                val retainedTokens = SELF.tokens.map { (t: (Coll[Byte], Long)) =>
                    (t._1, t._2 - (t._2.toBigInt * burned.toBigInt / remaining.toBigInt).toLong)
                }.filter { (t: (Coll[Byte], Long)) => t._2 > 0L }

                val paid = payoutTagged && payout.value >= paidERG && payout.tokens == paidTokens
                val continued =
                    next.propositionBytes == SELF.propositionBytes &&
                    next.value >= SELF.value - paidERG &&
                    next.tokens == retainedTokens &&
                    next.R4[Coll[Byte]].get == SELF.R4[Coll[Byte]].get &&
                    next.R5[Coll[Byte]].get == assetId &&
                    next.R6[Byte].get == SELF.R6[Byte].get &&
                    next.R7[Long].get == remaining - burned &&
                    next.R8[Coll[Byte]].get == SELF.id

                sigmaProp(paid && continued)
            }
        }
    }
}
