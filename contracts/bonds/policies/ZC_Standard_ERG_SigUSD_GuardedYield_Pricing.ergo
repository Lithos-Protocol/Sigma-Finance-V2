{
    // PricedAsk var 2: ZC_Standard_YieldAsk_Pricing with a sale guard. The same two-point yield price,
    // plus a minimum collateral cover at a fresh oracle, so a resting ask never sells a bond that is
    // under (or just over) its liquidation ratio to a buyer who would liquidate it at once.
    // Ask R5: 4 N, 5 start height, 6 start yield, 7 end height, 8 end yield, as YieldAsk_Pricing;
    //   9 minimum cover in bps of the repayment (> 0), 10 maximum oracle age in blocks (1..100000).
    // R7 = bond asset id; var 3 = data-input index of the live bond's state box. The USD Oracle v2
    // pool is found among the data inputs by its NFT, at any index, exactly once.
    // Price: paid * N * (B * L + Y * D) >= sold * R * B * L, B = 10000 * 262800 (see YieldAsk_Pricing).
    // Cover, measured as ZC_Standard_ERG_SigUSD_Liquidation does (SigUSD at $1, other tokens at zero,
    // the lender's fee reserve excluded):
    //   (100 * collateral nanoERG + rate * collateral SigUSD) * 10000 >= debt * min cover,
    //   debt = 100 * repayment nanoERG, or rate * repayment SigUSD.
    // A very large yield prices near zero, so the shell's floor binds: a guarded fixed price.
    val terms = SELF.R5[Coll[Long]].get
    val payoutIndex = getVar[Int](0).get
    val nextIndex = getVar[Int](1)
    val stateIndex = getVar[Int](3).get

    if (terms.size < 11 || SELF.tokens.size != 1 ||
        payoutIndex < 0 || payoutIndex >= OUTPUTS.size ||
        stateIndex < 0 || stateIndex >= CONTEXT.dataInputs.size) {
        sigmaProp(false)
    } else {
        val wholeUnits = terms(4)
        val start = terms(5)
        val startYield = terms(6)
        val end = terms(7)
        val endYield = terms(8)
        val minBps = terms(9)
        val maxAge = terms(10)
        val asset = SELF.R7[Coll[Byte]].get
        val state = CONTEXT.dataInputs(stateIndex)
        val isBond =
            blake2b256(state.propositionBytes) == CONST_BOND_HASH &&
            state.tokens.size > 0 && state.tokens(0)._1 == asset && state.tokens(0)._2 == 2L
        val oracleNFT = fromBase16("6a2b821b5727e85beb5e78b4efb9f0250d59cd48481d2ded2c23e91ba1d07c66")
        val sigUSD = fromBase16("03faf2cb329f2e90d6d23b58d91bbb6c046aa143261cc21f52fbe2824bfcbf04")
        val pools = CONTEXT.dataInputs.filter { (b: Box) =>
            b.tokens.exists { (t: (Coll[Byte], Long)) => t._1 == oracleNFT && t._2 == 1L }
        }

        if (!isBond || startYield < 0L || endYield < 0L || end <= start ||
            wholeUnits < 1L || wholeUnits > 1000000000L ||
            minBps <= 0L || maxAge < 1L || maxAge > 100000L || pools.size != 1) {
            sigmaProp(false)
        } else {
            val borrower = state.R6[Coll[Long]].get
            val lender = state.R9[Coll[Long]].get
            val repaysERG = CONST_REPAYMENT_TOKEN == SELF.id.slice(0, 0)
            val supported = repaysERG || CONST_REPAYMENT_TOKEN == sigUSD
            val repayment = borrower(0)
            val fee = lender(0)
            val maturity = lender(2)
            val blocksLeft = maturity - HEIGHT.toLong

            val payout = OUTPUTS(payoutIndex)
            val paid = if (repaysERG) {
                payout.value
            } else if (payout.tokens.size > 0 && payout.tokens(0)._1 == CONST_REPAYMENT_TOKEN) {
                payout.tokens(0)._2
            } else 0L
            val remaining = if (nextIndex.isDefined) OUTPUTS(nextIndex.get).tokens(0)._2 else 0L
            val sold = SELF.tokens(0)._2 - remaining

            val pool = pools(0)
            val price = pool.R4[Long].get
            val epoch = pool.R5[Int].get
            val created = pool.creationInfo._1.toLong
            val fresh = created >= 0L && created <= HEIGHT.toLong && HEIGHT.toLong - created <= maxAge

            if (repayment <= 0L || blocksLeft <= 0L || sold < 1L ||
                !supported || !fresh || price <= 0L || epoch < 0 || fee < 0L || fee > state.value) {
                sigmaProp(false)
            } else {
                val now = HEIGHT.toLong
                val at = if (now < start) start else if (now > end) end else now
                val span = (end - start).toBigInt
                val rate = startYield.toBigInt * span + (endYield.toBigInt - startYield.toBigInt) * (at - start).toBigInt
                val scale = 2628000000L.toBigInt
                val collateralUSD = state.tokens.slice(1, state.tokens.size).fold(0L, { (a: Long, t: (Coll[Byte], Long)) =>
                    if (t._1 == sigUSD) a + t._2 else a
                })
                val collateralValue = (state.value - fee).toBigInt * 100L.toBigInt +
                    price.toBigInt * collateralUSD.toBigInt
                val debtValue = if (repaysERG) repayment.toBigInt * 100L.toBigInt
                    else price.toBigInt * repayment.toBigInt
                sigmaProp(
                    paid.toBigInt * wholeUnits.toBigInt * (scale * span + rate * blocksLeft.toBigInt) >=
                        sold.toBigInt * repayment.toBigInt * scale * span &&
                    collateralValue * 10000L.toBigInt >= debtValue * minBps.toBigInt
                )
            }
        }
    }
}
